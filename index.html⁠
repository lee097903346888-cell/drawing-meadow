async function smartCutout(
  file,
  strength=120
){

  const bmp =
    await createImageBitmap(file);


  const max =
    820;


  const scale =
    Math.min(
      1,
      max /
      Math.max(
        bmp.width,
        bmp.height
      )
    );


  const w =
    Math.max(
      1,
      Math.round(
        bmp.width*scale
      )
    );


  const h =
    Math.max(
      1,
      Math.round(
        bmp.height*scale
      )
    );


  const c =
    document.createElement(
      'canvas'
    );


  c.width =
    w;

  c.height =
    h;


  const x =
    c.getContext(
      '2d',
      {willReadFrequently:true}
    );


  x.drawImage(
    bmp,
    0,
    0,
    w,
    h
  );


  bmp.close?.();


  const im =
    x.getImageData(
      0,
      0,
      w,
      h
    );


  const d =
    im.data;


  const N =
    w*h;


  const border = [];


  const sample =
    (px,py)=>{

      const i =
        (py*w+px)*4;


      border.push(
        [
          d[i],
          d[i+1],
          d[i+2]
        ]
      );
    };


  for(
    let xx=0;
    xx<w;
    xx+=4
  ){

    sample(xx,0);

    sample(xx,h-1);
  }


  for(
    let yy=0;
    yy<h;
    yy+=4
  ){

    sample(0,yy);

    sample(w-1,yy);
  }


  border.sort(
    (a,b)=>
      (
        b[0]+b[1]+b[2]
      )
      -
      (
        a[0]+a[1]+a[2]
      )
  );


  const take =
    border.slice(
      0,
      Math.max(
        8,
        Math.floor(
          border.length*.65
        )
      )
    );


  const bg =
    take
      .reduce(
        (a,p)=>[
          a[0]+p[0],
          a[1]+p[1],
          a[2]+p[2]
        ],
        [0,0,0]
      )
      .map(
        v=>v/take.length
      );


  const bgLum =
    .2126*bg[0] +
    .7152*bg[1] +
    .0722*bg[2];


  const protect =
    new Uint8Array(N);


  const dilated =
    new Uint8Array(N);


  const seen =
    new Uint8Array(N);


  const inkThreshold =
    48 +
    Math.max(
      0,
      strength-80
    )*.34;


  for(
    let p=0;
    p<N;
    p++
  ){

    const i =
      p*4;


    const r =
      d[i];

    const g =
      d[i+1];

    const b =
      d[i+2];


    const mx =
      Math.max(r,g,b);


    const mn =
      Math.min(r,g,b);


    const sat =
      mx
      ? ((mx-mn)/mx)
      : 0;


    const lum =
      .2126*r +
      .7152*g +
      .0722*b;


    const dist =
      Math.hypot(
        r-bg[0],
        g-bg[1],
        b-bg[2]
      );


    if(
      dist > inkThreshold ||
      (
        sat>.16 &&
        dist>24
      ) ||
      (
        bgLum-lum>48
      )
    ){

      protect[p] =
        1;
    }
  }


  const rad =
    2;


  for(
    let yy=0;
    yy<h;
    yy++
  ){

    for(
      let xx=0;
      xx<w;
      xx++
    ){

      const p =
        yy*w+xx;


      if(!protect[p]){
        continue;
      }


      for(
        let dy=-rad;
        dy<=rad;
        dy++
      ){

        for(
          let dx=-rad;
          dx<=rad;
          dx++
        ){

          const nx =
            xx+dx;


          const ny =
            yy+dy;


          if(
            nx>=0 &&
            ny>=0 &&
            nx<w &&
            ny<h
          ){

            dilated[
              ny*w+nx
            ] = 1;
          }
        }
      }
    }
  }


  const q =
    new Int32Array(N);


  const qx =
    new Int32Array(N);


  const qy =
    new Int32Array(N);


  let head =
    0;


  let tail =
    0;


  const push =
    (xx,yy)=>{

      const p =
        yy*w+xx;


      if(
        seen[p] ||
        dilated[p]
      ){
        return;
      }


      const i =
        p*4;


      const r =
        d[i];

      const g =
        d[i+1];

      const b =
        d[i+2];


      const mx =
        Math.max(r,g,b);


      const mn =
        Math.min(r,g,b);


      const sat =
        mx
        ? ((mx-mn)/mx)
        : 0;


      const lum =
        .2126*r +
        .7152*g +
        .0722*b;


      const dist =
        Math.hypot(
          r-bg[0],
          g-bg[1],
          b-bg[2]
        );


      const removable =

        dist <
        strength*1.42

        ||

        (
          lum>205 &&
          sat<.13
        )

        ||

        (
          dist <
          strength*1.8
          &&
          lum >
          bgLum-45
          &&
          sat<.18
        );


      if(!removable){
        return;
      }


      seen[p] =
        1;


      q[tail] =
        p;


      qx[tail] =
        xx;


      qy[tail] =
        yy;


      tail++;
    };


  for(
    let xx=0;
    xx<w;
    xx++
  ){

    push(xx,0);

    push(xx,h-1);
  }


  for(
    let yy=0;
    yy<h;
    yy++
  ){

    push(0,yy);

    push(w-1,yy);
  }


  while(
    head<tail
  ){

    const xx =
      qx[head];


    const yy =
      qy[head];


    head++;


    if(xx>0){
      push(xx-1,yy);
    }


    if(xx+1<w){
      push(xx+1,yy);
    }


    if(yy>0){
      push(xx,yy-1);
    }


    if(yy+1<h){
      push(xx,yy+1);
    }
  }


  for(
    let p=0;
    p<N;
    p++
  ){

    if(seen[p]){

      d[p*4+3] =
        0;
    }
  }


  /* 去白邊 */

  for(
    let yy=1;
    yy<h-1;
    yy++
  ){

    for(
      let xx=1;
      xx<w-1;
      xx++
    ){

      const p =
        yy*w+xx;


      const i =
        p*4;


      if(
        d[i+3]===0
      ){
        continue;
      }


      const nearZero =

        d[((yy-1)*w+xx)*4+3]===0

        ||

        d[((yy+1)*w+xx)*4+3]===0

        ||

        d[(yy*w+xx-1)*4+3]===0

        ||

        d[(yy*w+xx+1)*4+3]===0;


      if(nearZero){

        const lum =
          (
            d[i] +
            d[i+1] +
            d[i+2]
          )/3;


        if(lum>210){

          d[i+3] =
            Math.min(
              d[i+3],
              170
            );
        }
      }
    }
  }


  x.putImageData(
    im,
    0,
    0
  );


  let minX=w;
  let minY=h;
  let maxX=-1;
  let maxY=-1;


  for(
    let yy=0;
    yy<h;
    yy++
  ){

    for(
      let xx=0;
      xx<w;
      xx++
    ){

      if(
        d[
          (yy*w+xx)*4+3
        ] > 12
      ){

        if(xx<minX){
          minX=xx;
        }

        if(xx>maxX){
          maxX=xx;
        }

        if(yy<minY){
          minY=yy;
        }

        if(yy>maxY){
          maxY=yy;
        }
      }
    }
  }


  if(maxX<0){

    throw new Error(
      '沒有辨識到畫作主體，請換一張背景較亮的照片。'
    );
  }


  const pad =
    10;


  minX =
    Math.max(
      0,
      minX-pad
    );


  minY =
    Math.max(
      0,
      minY-pad
    );


  maxX =
    Math.min(
      w-1,
      maxX+pad
    );


  maxY =
    Math.min(
      h-1,
      maxY+pad
    );


  const out =
    document.createElement(
      'canvas'
    );


  out.width =
    maxX-minX+1;


  out.height =
    maxY-minY+1;


  out
    .getContext('2d')
    .drawImage(
      c,
      minX,
      minY,
      out.width,
      out.height,
      0,
      0,
      out.width,
      out.height
    );


  return await new Promise(
    (res,rej)=>

      out.toBlob(

        b=>
          b
          ? res(b)
          : rej(
              new Error(
                '圖片處理失敗'
              )
            ),

        'image/webp',

        .92
      )
  );
}


async function deleteObject(id){

  const o =
    state.objects.get(id);


  if(!o){
    return;
  }


  const allowed =
    state.isHost ||
    o.owner_user_id ===
    state.user.id;


