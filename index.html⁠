            b.dataset.close ===
            'adminModal'
          ){

            state.running =
              true;


            state.hostLastTick =
              performance.now();
          }
        }
  );


$('copyLinkBtn').onclick =
  ()=>copyText(
    $('shareLink').value
  );


$('copyCodeBtn').onclick =
  ()=>copyText(
    state.room.code
  );


document
  .querySelectorAll('.typeBtn')
  .forEach(
    b=>
      b.onclick =
        ()=>{

          state.selectedKind =
            b.dataset.kind;


          $('fileInput')
            .click();
        }
  );


$('fileInput').onchange =
  e=>
    uploadSelected(
      e.target.files?.[0],
      state.selectedKind
    );


canvas.addEventListener(
  'pointerdown',
  e=>{

    const o =
      pickObject(
        e.clientX,
        e.clientY
      );


    if(o){

      state.selectedId =
        o.id;


      toast(

        o.kind==='food'

        ? `🍎 ${o.owner_nickname} 畫的食物`

        : (
            `${kindIcon(o.kind)} ` +
            `${o.name} · ` +
            `吃了 ${o.growth_meals||0} 份 · ` +
            `約 ${growthScale(o).toFixed(2)}×`
          )
      );

    }
    else{

      clearSelection();
    }
  }
);


$('deleteFloating').onclick =
  ()=>
    state.selectedId &&
    deleteObject(
      state.selectedId
    );


const adminIds = [

  'cutoutStrength',

  'visualSaturation',

  'dayMinutes',

  'worldSpeed',

  'wakeHour',

  'sleepHour',

  'breakfastHour',

  'lunchHour',

  'dinnerHour',

  'mealDuration',

  'growthStep',

  'weather',

  'infiniteGrowth',

  'weatherEnabled',

  'showNames',

  'showWeather',

  'uploadEnabled',

  'roomLocked'
];


adminIds.forEach(
  id=>{

    $(id)
      .addEventListener(
        'input',
        scheduleSettingsSave
      );


    $(id)
      .addEventListener(
        'change',
        scheduleSettingsSave
      );
  }
);


document
  .querySelectorAll('.quickTime')
  .forEach(
    b=>
      b.onclick =
        ()=>quickTime(
          +b.dataset.hour
        )
  );


$('clearBtn').onclick =
  clearRoom;


$('endRoomBtn').onclick =
  endRoom;


$('displayBtn').onclick =
  ()=>{

    window.open(

      location.origin +
      location.pathname +
      `?room=${state.room.code}` +
      `&display=1`,

      '_blank'
    );
  };


window.addEventListener(
  'resize',
  resizeCanvas
);


document.addEventListener(
  'visibilitychange',
  ()=>{

    if(!document.hidden){

      state.hostLastTick =
        performance.now();


      resizeCanvas();
    }
  }
);


(async function boot(){

  const saved =
    localStorage.getItem(
      'meadow_nickname'
    ) || '';


  $('nickname').value =
    saved;


  const params =
    new URLSearchParams(
      location.search
    );


  const code =
    params.get('room');


  if(code){

    $('roomCodeInput').value =
      code.toUpperCase();


    if(state.displayMode){

      try{

        await joinRoom(code);

      }
      catch{}
    }
  }

})();

</script>

</body>
</html>
