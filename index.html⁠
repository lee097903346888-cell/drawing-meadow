      320,
      Math.floor(
        r.width*DPR
      )
    );


  canvas.height =
    Math.max(
      420,
      Math.floor(
        r.height*DPR
      )
    );


  ctx.setTransform(
    DPR,
    0,
    0,
    DPR,
    0,
    0
  );
}


