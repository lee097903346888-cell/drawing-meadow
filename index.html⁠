function sleepMode(hour){

  const s = settings();

  return s.sleep_hour > s.wake_hour

    ? (
        hour >= s.sleep_hour ||
        hour < s.wake_hour
      )

    : (
        hour >= s.sleep_hour &&
        hour < s.wake_hour
      );
}


function seasonFor(day){

