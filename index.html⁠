function modeAt(hour){

  const s = settings();

  const dur =
    +s.meal_duration || 1;

  const meals = [

    [
      '🥣 早餐',
      'breakfast',
      +s.breakfast_hour
    ],

    [
      '🍱 午餐',
      'lunch',
      +s.lunch_hour
    ],

    [
      '🍲 晚餐',
      'dinner',
      +s.dinner_hour
    ]
  ];

  for(
    const [label,key,h]
    of meals
  ){

    if(
      hour >= h &&
      hour < h + dur
    ){
      return {label,key};
    }
  }

  return sleepMode(hour)

    ? {
        label:'💤 睡覺',
        key:'sleep'
      }

    : {
        label:'🎈 玩耍',
        key:'play'
      };
}


function fmtHour(h){

  h = ((h%24)+24)%24;

  const hh = Math.floor(h);

  const mm =
    Math.floor(
      (h-hh)*60
    );

  return (
    `${String(hh).padStart(2,'0')}:` +
    `${String(mm).padStart(2,'0')}`
  );
}


