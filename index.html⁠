function positionDeleteButton(){

  const o =
    state.selectedId &&
    state.objects.get(
      state.selectedId
    );


  const b =
    $('deleteFloating');


  if(!o?._box){

    b.style.display =
      'none';

    return;
  }


  const allowed =
    state.isHost ||
    o.owner_user_id ===
    state.user.id;


  if(!allowed){

    b.style.display =
      'none';

    return;
  }


  b.style.display =
    'block';


  const x =
    Math.max(
      8,
      Math.min(
        canvas.clientWidth-92,
        o._box.x+
        o._box.w/2-
        42
      )
    );


  const y =
    Math.max(
      8,
      o._box.y-42
    );


  b.style.left =
    x+'px';


  b.style.top =
    y+'px';
}


function pickObject(
  clientX,
  clientY
){

  const r =
    canvas
      .getBoundingClientRect();


  const x =
    clientX-r.left;


  const y =
    clientY-r.top;


  let best =
    null;


  for(
    const o
    of [...state.objects.values()]
      .reverse()
  ){

    const b =
      o._box;


    if(!b){
      continue;
    }


    if(
      x>=b.x &&
      x<=b.x+b.w &&
      y>=b.y &&
      y<=b.y+b.h
    ){

      best =
        o;

      break;
    }
  }


  return best;
}


