<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#8bd26f" />
  <title>圖畫草原書｜多人共創世界</title>

  <style>
    :root{
      --ink:#223325;
      --card:#fffdf5;
      --green:#4f9e4a;
      --green2:#78c760;
      --blue:#5bbce5;
      --sun:#ffd65b;
      --danger:#d9534f;
      --shadow:0 12px 32px rgba(34,51,37,.16)
    }

    *{box-sizing:border-box}

    html,body{
      margin:0;
      min-height:100%;
      font-family:ui-rounded,"PingFang TC","Microsoft JhengHei",system-ui,sans-serif;
      color:var(--ink);
      background:#dff3d1
    }

    button,input,select{font:inherit}
    button{cursor:pointer;border:0}
    .hidden{display:none!important}

    #app{
      min-height:100vh;
      background:linear-gradient(#c9efff 0 36%,#c9eaa3 36% 100%)
    }

    .start{
      min-height:100vh;
      position:relative;
      overflow:hidden;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:28px 18px 34px;
      background:linear-gradient(#91ddff 0 46%,#b7e990 46% 100%)
    }

    .start:before{
      content:"";
      position:absolute;
      width:140px;
      height:140px;
      border-radius:50%;
      right:8%;
      top:7%;
      background:#ffe56f;
      box-shadow:0 0 0 14px rgba(255,240,138,.22)
    }

    .start:after{
      content:"";
      position:absolute;
      left:-5%;
      right:-5%;
      bottom:-30px;
      height:42%;
      background:
        radial-gradient(ellipse at 15% 100%,#5ca950 0 28%,transparent 29%),
        radial-gradient(ellipse at 45% 100%,#70bd59 0 31%,transparent 32%),
        radial-gradient(ellipse at 78% 100%,#4f9d49 0 30%,transparent 31%);
      opacity:.95;
      pointer-events:none
    }

    .welcomeShell{
      position:relative;
      z-index:2;
      width:min(1040px,100%);
      display:grid;
      grid-template-columns:minmax(0,1.02fr) minmax(340px,.98fr);
      gap:24px;
      align-items:center
    }

    .heroCopy{
      padding:18px 8px 18px 4px;
      text-shadow:0 2px 0 rgba(255,255,255,.18)
    }

    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:7px;
      background:rgba(255,255,255,.82);
      border:2px solid rgba(255,255,255,.78);
      padding:8px 12px;
      border-radius:999px;
      font-weight:1000;
      color:#397040;
      box-shadow:0 8px 24px rgba(45,92,51,.12)
    }

    .logo{
      font-size:clamp(43px,7vw,76px);
      font-weight:1000;
      letter-spacing:.025em;
      line-height:1.03;
      margin:15px 0 10px;
      color:#244b2e
    }

    .sub{
      margin:0;
      color:#355f3d;
      font-size:clamp(17px,2.3vw,23px);
      line-height:1.55;
      font-weight:900;
      max-width:620px
    }

    .heroChips{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:18px
    }

    .heroChip{
      background:rgba(255,255,255,.79);
      padding:8px 11px;
      border-radius:999px;
      font-size:13px;
      font-weight:900;
      color:#416b48;
      border:1px solid rgba(255,255,255,.8)
    }

    .heroAnimals{
      margin-top:24px;
      display:flex;
      align-items:flex-end;
      gap:8px;
      font-size:clamp(38px,6vw,70px);
      filter:drop-shadow(0 7px 0 rgba(67,110,65,.12))
    }

    .heroAnimals span:nth-child(2){transform:translateY(-17px)}
    .heroAnimals span:nth-child(4){transform:translateY(-9px)}

    .startCard{
      width:100%;
      background:rgba(255,253,245,.96);
      border:4px solid rgba(255,255,255,.9);
      border-radius:32px;
      padding:22px;
      box-shadow:0 22px 55px rgba(40,82,48,.22);
      backdrop-filter:blur(9px)
    }

    .startCard h2{
      margin:0 0 5px;
      font-size:26px
    }

    .startLead{
      margin:0 0 14px;
      color:#677a68;
      font-weight:750;
      line-height:1.55
    }

    .fieldLabel{
      display:block;
      text-align:left;
      margin:9px 4px 3px;
      color:#536955;
      font-weight:900;
      font-size:13px
    }

    .start input{
      width:100%;
      padding:14px 16px;
      border:2px solid #d6e6d1;
      border-radius:16px;
      background:white;
      outline:none;
      margin:5px 0;
      font-weight:850;
      color:#294331;
      box-shadow:inset 0 1px 0 rgba(0,0,0,.02)
    }

    .start input:focus{
      border-color:#70b865;
      box-shadow:0 0 0 4px rgba(112,184,101,.13)
    }

    .choiceGrid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-top:11px
    }

    .choiceCard{
      border-radius:20px;
      padding:14px 13px;
      text-align:left;
      background:#f5fbf0;
      border:2px solid #dcebd6
    }

    .choiceCard.blue{
      background:#eff8ff;
      border-color:#d9ebf7
    }

    .choiceTitle{
      font-size:16px;
      font-weight:1000;
      margin-bottom:4px
    }

    .choiceHint{
      font-size:12px;
      color:#718071;
      line-height:1.45;
      min-height:34px
    }

    .bigBtn{
      width:100%;
      padding:14px;
      border-radius:16px;
      margin:10px 0 0;
      font-weight:1000;
      font-size:16px;
      color:white;
      box-shadow:0 6px 0 rgba(0,0,0,.10);
      transition:transform .12s,filter .12s
    }

    .bigBtn:hover{filter:brightness(1.03)}

    .bigBtn:active{
      transform:translateY(3px);
      box-shadow:0 3px 0 rgba(0,0,0,.10)
    }

    .createBtn{
      background:linear-gradient(135deg,#5bb453,#459f48)
    }

    .joinBtn{
      background:linear-gradient(135deg,#49aee0,#358ec1)
    }

    .ghostBtn{
      background:#fff;
      color:#3e5841;
      border:2px solid #d9e8d2;
      box-shadow:none
    }

    .joinCodeLabel{margin-top:5px}

    .privacyNote{
      display:flex;
      gap:8px;
      align-items:flex-start;
      margin-top:13px;
      padding:10px 11px;
      border-radius:14px;
      background:#f3f6ef;
      color:#667467;
      font-size:12px;
      line-height:1.5
    }

    .privacyNote b{color:#425943}

    .startFooter{
      text-align:center;
      color:#4f7156;
      font-size:12px;
      font-weight:800;
      margin-top:9px
    }

    .tiny{
      font-size:12px;
      color:#6d7e6f;
      line-height:1.55
    }

    .error{
      margin-top:10px;
      color:#b63d39;
      font-weight:800;
      white-space:pre-wrap
    }

    #game{
      min-height:100vh;
      padding:10px max(10px,env(safe-area-inset-right))
        calc(14px + env(safe-area-inset-bottom))
        max(10px,env(safe-area-inset-left));
      display:flex;
      flex-direction:column;
      gap:10px;
      background:#d7edbe
    }

    .topbar{
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      background:rgba(255,255,255,.92);
      padding:8px 10px;
      border-radius:18px;
      box-shadow:0 5px 18px rgba(0,0,0,.10);
      z-index:5
    }

    .brand{
      font-weight:1000;
      margin-right:auto
    }

    .pill{
      background:#eef7e8;
      padding:7px 10px;
      border-radius:999px;
      font-weight:900;
      font-size:13px;
      white-space:nowrap
    }

    .pill.blue{background:#e3f5ff}
    .pill.gold{background:#fff2bf}

    .iconBtn{
      width:38px;
      height:38px;
      border-radius:12px;
      background:#fff1bc;
      font-size:20px;
      box-shadow:inset 0 0 0 2px rgba(111,87,23,.08)
    }

    .stageWrap{
      position:relative;
      flex:1;
      min-height:520px;
      border-radius:26px;
      overflow:hidden;
      border:4px solid rgba(255,255,255,.8);
      box-shadow:var(--shadow);
      background:#9bdcff
    }

    #world{
      display:block;
      width:100%;
      height:100%;
      min-height:520px;
      touch-action:manipulation
    }

    .floating{
      position:absolute;
      left:50%;
      top:12px;
      transform:translateX(-50%);
      padding:8px 12px;
      border-radius:999px;
      background:rgba(255,255,255,.92);
      font-weight:900;
      pointer-events:none;
      opacity:0;
      transition:.2s;
      box-shadow:0 4px 14px rgba(0,0,0,.13)
    }

    .floating.show{
      opacity:1;
      transform:translate(-50%,4px)
    }

    #deleteFloating{
      position:absolute;
      z-index:8;
      background:#e6534f;
      color:white;
      padding:8px 11px;
      border-radius:12px;
      font-weight:900;
      box-shadow:0 6px 14px rgba(120,30,30,.25);
      display:none
    }

    .uploadRow{
      display:grid;
      grid-template-columns:repeat(5,1fr);
      gap:8px;
      background:rgba(255,255,255,.91);
      padding:8px;
      border-radius:20px;
      box-shadow:0 6px 18px rgba(0,0,0,.08)
    }

    .typeBtn{
      min-height:70px;
      border-radius:16px;
      background:white;
      border:2px solid #e2eadf;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:2px;
      font-weight:900;
      color:#344c36
    }

    .typeBtn span{font-size:28px}

    .typeBtn:disabled{
      opacity:.45;
      filter:grayscale(.5)
    }

    .typeBtn.food{background:#fff7df}
    .typeBtn.bird{background:#eaf8ff}
    .typeBtn.fish{background:#e8f7ff}
    .typeBtn.reptile{background:#eef6d6}

    .displayMode .uploadRow,
    .displayMode #gearBtn{
      display:none!important
    }

    .displayMode .stageWrap{
      min-height:calc(100vh - 76px)
    }

    .displayMode #world{
      min-height:calc(100vh - 76px)
    }

    .modalBackdrop{
      position:fixed;
      inset:0;
      background:rgba(28,42,32,.56);
      display:grid;
      place-items:center;
      padding:14px;
      z-index:30;
      backdrop-filter:blur(5px)
    }

    .modal{
      width:min(680px,100%);
      max-height:90vh;
      overflow:auto;
      background:#fffdf7;
      border-radius:28px;
      padding:20px;
      box-shadow:0 24px 70px rgba(0,0,0,.28);
      border:3px solid #fff
    }

    .modal h2{margin:0 0 12px}

    .close{
      float:right;
      width:38px;
      height:38px;
      border-radius:12px;
      background:#edf1e9;
      font-size:20px
    }

    .roomCode{
      font-size:42px;
      font-weight:1000;
      letter-spacing:.16em;
      color:#2f7f47;
      margin:8px 0
    }

    .shareGrid{
      display:grid;
      grid-template-columns:200px 1fr;
      gap:16px;
      align-items:center
    }

    .qrBox{
      width:190px;
      height:190px;
      background:#fff;
      border:8px solid white;
      border-radius:18px;
      box-shadow:0 0 0 2px #dfe9da;
      display:grid;
      place-items:center;
      overflow:hidden
    }

    .shareLink{
      width:100%;
      padding:12px;
      border:2px solid #d8e6d1;
      border-radius:12px;
      background:#f8fbf6
    }

    .adminGrid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px
    }

    .setting{
      background:#f4f7f0;
      border:1px solid #dfe8da;
      border-radius:16px;
      padding:12px
    }

    .setting label{
      display:flex;
      justify-content:space-between;
      gap:8px;
      font-weight:900;
      margin-bottom:7px
    }

    .setting input[type=range]{width:100%}

    .setting input[type=number],
    .setting select{
      width:100%;
      padding:9px;
      border:1px solid #cad9c4;
      border-radius:10px;
      background:white
    }

    .switch{
      display:flex;
      align-items:center;
      gap:8px
    }

    .adminActions{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:12px
    }

    .smallBtn{
      padding:10px 12px;
      border-radius:12px;
      font-weight:900;
      background:#e6f1e0;
      color:#30523a
    }

    .smallBtn.blue{background:#dff2ff}

    .smallBtn.red{
      background:#ffe1df;
      color:#9f2d29
    }

    .smallBtn.gold{background:#fff0b8}

    .log{
      background:#18251b;
      color:#d9f2db;
      border-radius:14px;
      padding:10px;
      height:130px;
      overflow:auto;
      font:12px/1.5 ui-monospace,monospace;
      white-space:pre-wrap;
      margin-top:10px
    }

    .memberList{
      display:flex;
      flex-wrap:wrap;
      gap:6px
    }

    .memberChip{
      background:#e9f4e5;
      border-radius:999px;
      padding:6px 9px;
      font-size:12px;
      font-weight:800
    }

    .ended{
      position:absolute;
      inset:0;
      z-index:12;
      background:rgba(34,48,37,.68);
      display:grid;
      place-items:center;
      color:white;
      text-align:center;
      padding:20px
    }

    .endedBox{
      font-size:26px;
      font-weight:1000;
      background:rgba(30,40,32,.72);
      padding:20px 28px;
      border-radius:24px
    }

    @media(max-width:760px){
      .welcomeShell{grid-template-columns:1fr;gap:4px}
      .heroCopy{text-align:center;padding:4px 8px 8px}
      .logo{font-size:clamp(40px,12vw,62px)}
      .sub{margin-inline:auto;font-size:17px}
      .heroChips{justify-content:center}
      .heroAnimals{justify-content:center;margin-top:12px;font-size:43px}
      .heroAnimals span:nth-child(2){transform:translateY(-8px)}
      .start{align-items:flex-start;padding-top:22px}
      .choiceGrid{grid-template-columns:1fr}
      .choiceHint{min-height:auto}
      .startCard{padding:18px}
      .stageWrap,#world{min-height:58vh}
      .uploadRow{gap:5px}
      .typeBtn{min-height:62px;font-size:11px}
      .typeBtn span{font-size:24px}
      .shareGrid{grid-template-columns:1fr}
      .qrBox{margin:auto}
      .adminGrid{grid-template-columns:1fr}
      .brand{width:100%;margin:0}
      .topbar{justify-content:center}
      .roomCode{font-size:34px}
    }
  </style>
</head>

<body>

<div id="app">

  <section id="startScreen" class="start">

    <div class="welcomeShell">

      <div class="heroCopy">

        <div class="eyebrow">
          🌈 一起把孩子的畫變成會生活的世界
        </div>

        <h1 class="logo">圖畫草原書</h1>

        <p class="sub">
          畫一隻鳥、一條魚，或一份好吃的食物。
          上傳後，它們會一起住進同一片草原，和朋友的作品相遇。
        </p>

        <div class="heroChips">
          <span class="heroChip">🐦 天空飛翔</span>
          <span class="heroChip">🐾 草地散步</span>
          <span class="heroChip">🦎 地面爬行</span>
          <span class="heroChip">🐟 河裡游泳</span>
          <span class="heroChip">🍎 一起吃飯長大</span>
        </div>

        <div class="heroAnimals" aria-hidden="true">
          <span>🐛</span>
          <span>🐦</span>
          <span>🌳</span>
          <span>🦋</span>
          <span>🐟</span>
        </div>

      </div>

      <div class="startCard">

        <h2>👋 歡迎來到草原</h2>

        <p class="startLead">
          先取一個暱稱，再選擇建立自己的世界，
          或加入朋友的房間。
        </p>

        <label class="fieldLabel" for="nickname">你的暱稱</label>

        <input
          id="nickname"
          maxlength="24"
          placeholder="例如：小安"
          autocomplete="nickname"
        />

        <div class="choiceGrid">

          <div class="choiceCard">

            <div class="choiceTitle">
              🌱 我要建立世界
            </div>

            <div class="choiceHint">
              建立後會得到 6 位房間碼與 QR Code，
              邀請大家一起畫。
            </div>

            <button id="createRoomBtn" class="bigBtn createBtn">
              建立新世界
            </button>

          </div>

          <div class="choiceCard blue">

            <div class="choiceTitle">
              🚪 我要加入世界
            </div>

            <div class="choiceHint">
              輸入朋友分享的 6 位房間碼，
              就能進入同一片草原。
            </div>

            <label class="fieldLabel joinCodeLabel" for="roomCodeInput">
              房間碼
            </label>

            <input
              id="roomCodeInput"
              maxlength="6"
              placeholder="例如 A7K3P2"
              inputmode="text"
              style="
                text-transform:uppercase;
                letter-spacing:.14em;
                text-align:center;
                font-size:18px
              "
            />

            <button id="joinRoomBtn" class="bigBtn joinBtn">
              加入朋友的世界
            </button>

          </div>

        </div>

        <div class="privacyNote">

          <span>🔒</span>

          <div>
            <b>不用註冊帳號。</b>
            第一次進入會自動建立匿名身份，
            用來區分房主與每位孩子自己的作品。
          </div>

        </div>

        <div id="startStatus" class="tiny" style="margin-top:8px">
          準備好後，就可以開始共創。
        </div>

        <div id="startError" class="error"></div>

        <div class="startFooter">
          v14 多人共創版 · 手機 / 平板 / 電腦都能玩
        </div>

      </div>

    </div>

  </section>


  <section id="game" class="hidden">

    <div class="topbar">

      <div class="brand">
        🌿 圖畫草原書
      </div>

      <div id="roomPill" class="pill">
        房間 ------
      </div>

      <button id="shareBtn" class="pill blue">
        📱 邀請
      </button>

      <div id="onlinePill" class="pill blue">
        👥 1
      </div>

      <div id="timePill" class="pill gold">
        ☀️ 09:00
      </div>

      <div id="modePill" class="pill">
        🎈 玩耍
      </div>

      <button
        id="gearBtn"
        class="iconBtn hidden"
        title="大人後台"
      >
        ⚙️
      </button>

    </div>


    <div class="stageWrap" id="stageWrap">

      <canvas id="world"></canvas>

      <div id="toast" class="floating"></div>

      <button id="deleteFloating">
        🗑 刪除
      </button>

      <div id="endedOverlay" class="ended hidden">

        <div class="endedBox">
          🌙 這個共創世界已結束
          <br>
          <small style="font-size:15px">
            謝謝一起畫畫！
          </small>
        </div>

      </div>

    </div>


    <div class="uploadRow" id="uploadRow">

      <button class="typeBtn bird" data-kind="bird">
        <span>🐦</span>
        鳥類
      </button>

      <button class="typeBtn land" data-kind="land">
        <span>🐾</span>
        陸地
      </button>

      <button class="typeBtn reptile" data-kind="reptile">
        <span>🦎</span>
        爬蟲
      </button>

      <button class="typeBtn fish" data-kind="fish">
        <span>🐟</span>
        魚類
      </button>

      <button class="typeBtn food" data-kind="food">
        <span>🍎</span>
        食物
      </button>

      <input
        id="fileInput"
        type="file"
        accept="image/*"
        capture="environment"
        class="hidden"
      />

    </div>

  </section>


  <div id="shareModal" class="modalBackdrop hidden">

    <div class="modal">

      <button class="close" data-close="shareModal">
        ✕
      </button>

      <h2>📱 邀請大家一起畫</h2>

      <div class="roomCode" id="shareCode">
        ------
      </div>

      <div class="shareGrid">

        <div id="qrBox" class="qrBox"></div>

        <div>

          <p>
            <b>掃 QR Code</b>
            或輸入房間碼即可加入，不需要註冊。
          </p>

          <input
            id="shareLink"
            class="shareLink"
            readonly
          />

          <div class="adminActions">

            <button
              id="copyLinkBtn"
              class="smallBtn blue"
            >
              🔗 複製邀請連結
            </button>

            <button
              id="copyCodeBtn"
              class="smallBtn"
            >
              📋 複製房間碼
            </button>

          </div>

        </div>

      </div>

    </div>

  </div>


  <div id="adminModal" class="modalBackdrop hidden">

    <div class="modal">

      <button class="close" data-close="adminModal">
        ✕
      </button>

      <h2>⚙️ 大人後台模式</h2>

      <div class="tiny">
        房主修改後會同步給所有玩家。
        角色動畫仍在每台裝置本地播放，
        所以多人時網路負擔較低。
      </div>

      <div
        id="memberList"
        class="memberList"
        style="margin:10px 0"
      ></div>


