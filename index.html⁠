function friendlyError(e){

  const m =
    e?.message ||
    String(e);


  if(/ROOM_NOT_FOUND/.test(m)){

    return (
      '找不到這個房間，' +
      '請確認房間碼。'
    );
  }


  if(/ROOM_LOCKED/.test(m)){

    return (
      '這個房間已鎖定，' +
      '暫時不能加入。'
    );
  }


  if(/ROOM_FULL/.test(m)){

    return (
      '這個房間已達 50 人上限。'
    );
  }


  if(
    /relation .* does not exist|function .* does not exist|schema cache/i
      .test(m)
  ){

    return (
      'Supabase 還沒初始化。' +
      '請先在 SQL Editor 執行 supabase_setup.sql。\n\n' +
      m
    );
  }


  return m;
}


async function enterRoom(
  roomId,
  isHost,
  code
){

  state.isHost =
    !!isHost;


  const {
    data:room,
    error:rErr
  } =
    await sb
      .from('rooms')
      .select('*')
      .eq('id',roomId)
      .single();


  if(rErr){
    throw rErr;
  }


  state.room =
    room;


  state.room.code =
    code || room.code;


  const {
    data:objs,
    error:oErr
  } =
    await sb
      .from('objects')
      .select('*')
      .eq('room_id',roomId)
      .order('created_at');


  if(oErr){
    throw oErr;
  }


  state.objects.clear();


  for(
    const o
    of objs || []
  ){

    state.objects.set(
      o.id,
      makeRuntimeObject(o)
    );
  }


  await Promise.all(
    (objs || [])
      .map(loadObjectImage)
  );


  state.hostClock =
    +room.world_time;


  state.hostDay =
    room.world_day || 1;


  state.hostLastTick =
    performance.now();


  await subscribeRoom();


  $('startScreen')
    .classList
    .add('hidden');


  $('game')
    .classList
    .remove('hidden');


  $('gearBtn')
    .classList
    .toggle(
      'hidden',
      !state.isHost ||
      state.displayMode
    );


  $('roomPill')
    .textContent =
      `🌿 房間 ${room.code}`;


  if(state.displayMode){

    document.body
      .classList
      .add('displayMode');
  }


  syncAdminUI();

  updateUploadButtons();

  log(
    `進入房間 ${room.code}` +
    `${state.isHost?'（房主）':''}`
  );


  resizeCanvas();


  history.replaceState(
    null,
    '',
    location.pathname +
    `?room=${encodeURIComponent(room.code)}` +
    `${state.displayMode?'&display=1':''}`
  );
}


function makeRuntimeObject(o){

  const seed =
    hash01(o.id);

  return {

    ...o,

    rx:+o.x,

    ry:+o.y,

    vx:
      (.015 + seed*.018) *
      (seed>.5 ? 1 : -1),

    vy:
      (seed-.5)*.006,

    phase:
      seed*Math.PI*2,

    lastGrowth:
      o.growth_meals || 0
  };
}


async function loadObjectImage(o){

  if(
    !o?.image_path ||
    state.images.has(o.id)
  ){
    return;
  }


  const {
    data,
    error
  } =
    await sb.storage
      .from('drawings')
      .download(o.image_path);


  if(error){

    log(
      `圖片下載失敗 ${o.name}: ` +
      error.message
    );

    return;
  }


  const url =
    URL.createObjectURL(data);


  const img =
    new Image();


  img.onload =
    ()=>{
      state.images.set(
        o.id,
        {img,url}
      );
    };


  img.onerror =
    ()=>{
      URL.revokeObjectURL(url);
    };


  img.src =
    url;
}


function releaseImage(id){

  const v =
    state.images.get(id);


  if(v?.url){

    URL.revokeObjectURL(
      v.url
    );
  }


  state.images.delete(id);
}


async function subscribeRoom(){

  if(state.channel){

    await sb.removeChannel(
      state.channel
    );
  }


  const topic =
    `meadow:${state.room.code}`;


  const ch =
    sb.channel(
      topic,
      {
        config:{
          presence:{
            key:state.user.id
          }
        }
      }
    );


  state.channel =
    ch;


  ch
  .on(
    'presence',
    {event:'sync'},
    ()=>{
      state.presence =
        ch.presenceState();

      renderPresence();
    }
  )

  .on(
    'presence',
    {event:'join'},
    ()=>{
      state.presence =
        ch.presenceState();

      renderPresence();
    }
  )

  .on(
    'presence',
    {event:'leave'},
    ()=>{
      state.presence =
        ch.presenceState();

      renderPresence();
    }
  )

  .on(
    'postgres_changes',
    {
      event:'*',
      schema:'public',
      table:'objects',
      filter:
        `room_id=eq.${state.room.id}`
    },

    async payload=>{

      if(
        payload.eventType ===
        'INSERT'
      ){

        const o =
          makeRuntimeObject(
            payload.new
          );


        state.objects.set(
          o.id,
          o
        );


        await loadObjectImage(o);


        toast(
          `${kindIcon(o.kind)} ` +
          `${o.owner_nickname} 的作品進來了！`
        );

      }

      else if(
        payload.eventType ===
        'UPDATE'
      ){

        const old =
          state.objects.get(
            payload.new.id
          );


        const o =
          Object.assign(
            old ||
            makeRuntimeObject(
              payload.new
            ),
            payload.new
          );


        if(
          (
            old?.lastGrowth ??
            old?.growth_meals ??
            0
          )
          <
          payload.new.growth_meals
        ){

          o.lastGrowth =
            payload.new.growth_meals;


          o.growPulse =
            performance.now();


          toast(
            `🌱 ${o.name} 又長大了！`
          );
        }


        state.objects.set(
          o.id,
          o
        );

      }

      else if(
        payload.eventType ===
        'DELETE'
      ){

        releaseImage(
          payload.old.id
        );


        state.objects.delete(
          payload.old.id
        );


        if(
          state.selectedId ===
          payload.old.id
        ){

          clearSelection();
        }
      }
    }
  )

  .on(
    'postgres_changes',
    {
      event:'UPDATE',
      schema:'public',
      table:'rooms',
      filter:
        `id=eq.${state.room.id}`
    },

    payload=>{

      const prev =
        state.room;


      state.room = {
        ...state.room,
        ...payload.new
      };


      if(!state.isHost){

        state.hostClock =
          +state.room.world_time;


        state.hostDay =
          state.room.world_day || 1;


        state.hostLastTick =
          performance.now();
      }


      syncAdminUI();

      updateUploadButtons();


      if(
        prev?.status !== 'ended' &&
        state.room.status === 'ended'
      ){

        toast(
          '🌙 房主結束了這個世界'
        );
      }
    }
  );


  await new Promise(
    (resolve,reject)=>{

      ch.subscribe(
        async status=>{

          if(
            status === 'SUBSCRIBED'
          ){

            await ch.track({

              user_id:
                state.user.id,

              nickname:
                state.nickname,

              role:
                state.isHost
                  ? 'host'
                  : 'player',

              joined_at:
                new Date()
                  .toISOString()

            });


            resolve();
          }

          else if(
            status === 'CHANNEL_ERROR' ||
            status === 'TIMED_OUT'
          ){

            reject(
              new Error(
                'Realtime 連線失敗：' +
                status
              )
            );
          }
        }
      );

    }
  );
}


