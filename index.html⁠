  })[kind] || '新朋友';
}


function hash01(str){

  let h = 2166136261;

  for(
    let i=0;
    i<str.length;
    i++
  ){

    h ^= str.charCodeAt(i);

    h =
      Math.imul(
        h,
        16777619
      );
  }

  return (
    (h>>>0) /
    4294967295
  );
}


async function ensureAuth(){

  if(!sb){

    throw new Error(
      'Supabase 程式庫載入失敗，請確認網路可連到 jsDelivr。'
    );
  }

  const {
    data:{session}
  } =
    await sb.auth.getSession();


  if(session?.user){

    state.user =
      session.user;

    return;
  }


  const {
    data,
    error
  } =
    await sb.auth.signInAnonymously({

      options:{
        data:{
          app:'drawing-meadow-v14'
        }
      }

    });


  if(error){

    if(
      /anonymous|disabled|provider/i
        .test(error.message || '')
    ){

      throw new Error(
        'Supabase 匿名登入尚未開啟。' +
        '請到 Dashboard → Authentication → Providers，' +
        '啟用 Anonymous Sign-Ins。\n\n' +
        '原始錯誤：' +
        error.message
      );
    }

    throw error;
  }


  state.user =
    data.user;
}


