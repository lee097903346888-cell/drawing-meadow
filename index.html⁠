async function processMealIfNeeded(hour){

  if(
    !state.isHost ||
    state.room.status !== 'open'
  ){
    return;
  }


  const m =
    modeAt(hour);


  if(
    ![
      'breakfast',
      'lunch',
      'dinner'
    ].includes(m.key)
  ){
    return;
  }


  const key =
    `${state.hostDay}:${m.key}`;


  if(
    state.lastMealAttempt ===
    key
  ){
    return;
  }


  state.lastMealAttempt =
    key;


  const {
    data,
    error
  } =
    await sb.rpc(
      'process_meal',
      {
        p_room_id:
          state.room.id,

        p_meal_key:
          key
      }
    );


  if(error){

    log(
      '用餐處理失敗：' +
      error.message
    );

    return;
  }


  if(data?.processed){

    const paths =
      data.removed_paths ||
      [];


    if(paths.length){

      await sb.storage
        .from('drawings')
        .remove(paths);
    }


    if(
      (data.fed_ids || []).length
    ){

