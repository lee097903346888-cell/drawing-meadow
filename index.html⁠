        2300
      );
    }
  }
}


async function maybeChangeWeather(){

  const s =
    settings();


  if(
    !state.isHost ||
    !s.weather_enabled ||
    state.lastWeatherDay ===
    state.hostDay
  ){
    return;
  }


  state.lastWeatherDay =
    state.hostDay;


  if(Math.random()<.7){

    const list = [
      'sunny',
      'sunny',
      'cloudy',
      'rain',
      'snow'
    ];


    const w =
      list[
        Math.floor(
          Math.random() *
          list.length
        )
      ];


    await sb
      .from('rooms')
      .update({
        weather:w
      })
      .eq(
        'id',
        state.room.id
      );
  }
}


function updateHostClock(now){

  if(
    !state.isHost ||
    !state.room ||
    state.room.status !== 'open' ||
    !state.running
  ){
    return;
  }


  const s =
    settings();


  const dt =
    (
      now -
      state.hostLastTick
    ) / 1000;


  state.hostLastTick =
    now;


  const add =

    dt / 60

    *

    (
      24 /
      Math.max(
        1,
        +s.day_minutes
      )
    )

    *

    Math.max(
      .05,
      +s.world_speed
    );


  state.hostClock +=
    add;


  while(
    state.hostClock >= 24
  ){

    state.hostClock -=
      24;


    state.hostDay++;


    maybeChangeWeather();
  }


  processMealIfNeeded(
    state.hostClock
  );


  if(
    now -
    state.hostPushAt >
    4000
  ){

    state.hostPushAt =
      now;


    sb
      .from('rooms')
      .update({

        world_time:
          state.hostClock,

        world_day:
          state.hostDay

      })
      .eq(
        'id',
        state.room.id
      )
      .then(
        ({error})=>{

          if(error){

            log(
              '時間同步失敗：' +
              error.message
            );
          }
        }
      );
  }
}


function displayClock(){

  if(!state.room){

    return {
      hour:9,
      day:1
    };
  }


  if(state.isHost){

    return {

      hour:
        state.hostClock ??
        +state.room.world_time,

      day:
        state.hostDay ||
        state.room.world_day
    };
  }


  const s =
    settings();


  const dt =
    (
      performance.now() -
      state.hostLastTick
    ) / 1000;


  let h =

    +state.hostClock

    +

    dt / 60

    *

    (
      24 /
      Math.max(
        1,
        +s.day_minutes
      )
    )

    *

    Math.max(
      .05,
      +s.world_speed
    );


  let d =
    state.hostDay || 1;


  while(h>=24){

    h -= 24;

    d++;
  }


  return {
    hour:h,
    day:d
  };
}


const canvas =
  $('world');


const ctx =
  canvas.getContext('2d');


let DPR =
  1;


function resizeCanvas(){

  const r =
    $('stageWrap')
      .getBoundingClientRect();


  DPR =
    Math.min(
      2,
      window.devicePixelRatio ||
      1
    );


  canvas.width =
