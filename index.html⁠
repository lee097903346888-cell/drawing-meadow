  };
}


function growthScale(o){

  if(o.kind === 'food'){
    return 1;
  }

  const s = settings();

  const m =
    Math.max(
      0,
      o.growth_meals || 0
    );

  let g =
    1 +
    (+s.growth_step || .08) *
    Math.pow(m,.72);

  if(!s.infinite_growth){

    g = Math.min(
      g,
      1.35
    );
  }

  return g;
}


function safeName(kind){

