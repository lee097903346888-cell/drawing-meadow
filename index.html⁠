function drawScenery(
  W,
  H,
  hour,
  day,
  night,
  now
){

  const skyTop =
    night
    ? '#283a72'
    : '#78d1f2';


  const skyBot =
    night
    ? '#596aa1'
    : '#d4f4ff';


  const g =
    ctx.createLinearGradient(
      0,
      0,
      0,
      H*.56
    );


  g.addColorStop(
    0,
    skyTop
  );


  g.addColorStop(
    1,
    skyBot
  );


  ctx.fillStyle =
    g;


  ctx.fillRect(
    0,
    0,
    W,
    H*.58
  );


  if(!night){

    ctx.fillStyle =
      '#ffd85a';


    ctx.beginPath();


    ctx.arc(
      W*.82,
      H*.12,
      Math.min(W,H)*.055,
      0,
      Math.PI*2
    );


    ctx.fill();

  }
  else{

    ctx.fillStyle =
      '#f5f0d4';


    ctx.beginPath();


    ctx.arc(
      W*.82,
      H*.12,
      Math.min(W,H)*.045,
      0,
      Math.PI*2
    );


    ctx.fill();


    ctx.fillStyle =
      '#dff2ff';


    for(
      let i=0;
      i<18;
      i++
    ){

      const x =
        hash01(
          'star'+i
        )*W;


      const y =
        hash01(
          'sy'+i
        )*H*.42;


      ctx.globalAlpha =
        .5 +
        .5*Math.sin(
          now/700+i
        );


      ctx.fillRect(
        x,
        y,
        2,
        2
      );
    }


    ctx.globalAlpha =
      1;
  }


  ctx.fillStyle =
    night
    ? '#8894ba'
    : '#ffffff';


  ctx.globalAlpha =
    night
    ? .52
    : .92;


  for(
    const [x,y,s]
    of [
      [.18,.17,1],
      [.55,.10,.8],
      [.72,.28,.65]
    ]
  ){

    ctx.beginPath();


    ctx.arc(
      W*x,
      H*y,
      28*s,
      0,
      6.3
    );


    ctx.arc(
      W*x+28*s,
      H*y+4,
      22*s,
      0,
      6.3
    );


    ctx.arc(
      W*x-24*s,
      H*y+7,
      18*s,
      0,
      6.3
    );


    ctx.fill();
  }


  ctx.globalAlpha =
    1;


  ctx.fillStyle =
    night
    ? '#58744f'
    : '#78b75c';


  ctx.beginPath();


  ctx.moveTo(
    0,
    H*.48
  );


  for(
    let x=0;
    x<=W;
    x+=W/6
  ){

    ctx.quadraticCurveTo(
      x+W/12,
      H*(
        .39+
        hash01(
          'hill'+x
        )*.08
      ),
      x+W/6,
      H*.48
    );
  }


  ctx.lineTo(
    W,
    H*.78
  );


  ctx.lineTo(
    0,
    H*.78
  );


  ctx.fill();


  ctx.fillStyle =
    night
    ? '#496744'
    : '#7fc85d';


  ctx.fillRect(
    0,
    H*.50,
    W,
    H*.31
  );


  ctx.strokeStyle =
    night
    ? '#35543d'
    : '#3f9845';


  ctx.lineWidth =
    2;


  for(
    let i=0;
    i<70;
    i++
  ){

    const x =
      hash01(
        'grassx'+i
      )*W;


    const y =
      H*(
        .55+
        hash01(
          'grassy'+i
        )*.18
      );


    const hh =
      5+
      hash01(
        'grassh'+i
      )*12;


    ctx.beginPath();


    ctx.moveTo(
      x,
      y
    );


    ctx.lineTo(
      x-3,
      y-hh
    );


    ctx.moveTo(
      x,
      y
    );


    ctx.lineTo(
      x+3,
      y-hh*.8
    );


    ctx.stroke();
  }


  const tx =
    W*.1;


  const base =
    H*.67;


  ctx.fillStyle =
    night
    ? '#654d37'
    : '#8b5a35';


  ctx.fillRect(
    tx-13,
    base-115,
    26,
    120
  );


  ctx.fillStyle =
    night
    ? '#356044'
    : '#3f9b4e';


  for(
    const [dx,dy,r]
    of [
      [0,-125,52],
      [-35,-105,38],
      [34,-108,40],
      [3,-165,38]
    ]
  ){

    ctx.beginPath();


    ctx.arc(
      tx+dx,
      base+dy,
      r,
      0,
      6.3
    );


    ctx.fill();
  }


  const ry =
    H*.79;


  ctx.fillStyle =
    night
    ? '#2f5f83'
    : '#4fb8e7';


  ctx.fillRect(
    0,
    ry,
    W,
    H-ry
  );


  ctx.fillStyle =
    night
    ? '#47799b'
    : '#78d4f3';


  for(
    let i=0;
    i<7;
    i++
  ){

    ctx.fillRect(

      (
        i*.19*W +
        (now/55)%90
      ) - 80,

      ry+18+i*13,

      W*.14,

      3
    );
  }


  for(
    let i=0;
    i<18;
    i++
  ){

    const x =
      hash01(
        'rock'+i
      )*W;


    const y =
      ry-4+
      hash01(
        'rocky'+i
      )*18;


    ctx.fillStyle =
      i%2
      ? '#8b8c79'
      : '#aaa891';


    ctx.beginPath();


    ctx.ellipse(
      x,
      y,
      8+
      hash01(
        'rw'+i
      )*10,

      5+
      hash01(
        'rh'+i
      )*5,

      0,
      0,
      6.3
    );


    ctx.fill();
  }


  ctx.strokeStyle =
    night
    ? '#547450'
    : '#4e8b47';


  ctx.lineWidth =
    3;


  for(
    let i=0;
    i<12;
    i++
  ){

    const x =
      hash01(
        'reed'+i
      )*W;


    ctx.beginPath();


    ctx.moveTo(
      x,
      ry+7
    );


    ctx.lineTo(
      x-2,
      ry-24-
      hash01(
        'reedh'+i
      )*18
    );


    ctx.stroke();
  }


  for(
    let i=0;
    i<7;
    i++
  ){

    const x =
      hash01(
        'lily'+i
      )*W;


    const y =
      ry+35+
      hash01(
        'lilyy'+i
      )*
      (H-ry-50);


    ctx.fillStyle =
      '#4f9c53';


    ctx.beginPath();


    ctx.ellipse(
      x,
      y,
      12,
      6,
      0,
      0,
      6.3
    );


    ctx.fill();
  }


  const s =
    seasonFor(day);


  if(s==='秋天'){

    ctx.fillStyle =
      'rgba(214,135,53,.16)';


    ctx.fillRect(
      0,
      0,
      W,
      H
    );
  }


  if(
    s==='冬天' &&
    !night
  ){

    ctx.fillStyle =
      'rgba(225,241,247,.13)';


    ctx.fillRect(
      0,
      0,
      W,
      H
    );
  }
}


function drawWeather(
  W,
  H,
  now
){

  if(!state.room){
    return;
  }


  const w =
    state.room.weather;


  if(w==='rain'){

    ctx.strokeStyle =
      'rgba(55,110,160,.55)';


    ctx.lineWidth =
      1.5;


    for(
      let i=0;
      i<70;
      i++
    ){

      const x =
        (
          hash01(
            'rainx'+i
          )*W
          +
          now*.08
        ) % W;


      const y =
        (
          hash01(
            'rainy'+i
          )*H
          +
          now*.18
        ) % H;


      ctx.beginPath();


      ctx.moveTo(
        x,
        y
      );


      ctx.lineTo(
        x-5,
        y+14
      );


      ctx.stroke();
    }

  }

  else if(
    w==='snow'
  ){

    ctx.fillStyle =
      'rgba(255,255,255,.9)';


    for(
      let i=0;
      i<55;
      i++
    ){

      const x =
        (
          hash01(
            'snowx'+i
          )*W
          +
          Math.sin(
            now/800+i
          )*15
          +
          W
        ) % W;


      const y =
        (
          hash01(
            'snowy'+i
          )*H
          +
          now*.025*
          (
            1+
            hash01(
              'sp'+i
            )
          )
        ) % H;


      ctx.beginPath();


      ctx.arc(
        x,
        y,
        2+
        hash01(
          'sr'+i
        )*2,
        0,
        6.3
      );


      ctx.fill();
    }

  }

  else if(
    w==='cloudy'
  ){

    ctx.fillStyle =
      'rgba(120,130,140,.08)';


    ctx.fillRect(
      0,
      0,
      W,
      H
    );
  }
}


function updateObjectMotion(
  o,
  dt,
  night
){

  if(
    o.kind==='food' ||
    night
  ){
    return;
  }


  const speed =

    o.kind==='reptile'
    ? .35

    : o.kind==='bird'
    ? 1.1

    : o.kind==='fish'
    ? .8

    : .55;


  o.rx +=
    o.vx*dt*speed;


  o.ry +=
    o.vy*dt*speed;


  if(
    o.kind==='bird'
  ){

    o.ry +=
      Math.sin(
        performance.now()/700+
        o.phase
      )
      *.00035*dt;


    if(
      o.rx<.04 ||
      o.rx>.96
    ){

      o.vx *=
        -1;
    }


    if(
      o.ry<.07 ||
      o.ry>.42
    ){

      o.vy *=
        -1;
    }


    o.ry =
      Math.max(
        .07,
        Math.min(
          .42,
          o.ry
        )
      );

  }

  else if(
    o.kind==='fish'
  ){

    o.ry +=
      Math.sin(
        performance.now()/500+
        o.phase
      )
      *.0002*dt;


    if(
      o.rx<.03 ||
      o.rx>.97
    ){

      o.vx *=
        -1;
    }


    o.ry =
      Math.max(
        .82,
        Math.min(
          .96,
          o.ry
        )
      );

  }

  else{

    if(
      o.rx<.03 ||
      o.rx>.97
    ){

      o.vx *=
        -1;
    }


    const min =
      o.kind==='reptile'
      ? .66
      : .49;


    const max =
      .77;


    if(
      o.ry<min ||
      o.ry>max
    ){

      o.vy *=
        -1;
    }


    o.ry =
      Math.max(
        min,
        Math.min(
          max,
          o.ry
        )
      );
  }
}


let lastFrame =
  performance.now();


function drawObjects(
  W,
  H,
  hour,
  night,
  now
){

  const dt =
    Math.min(
      .05,
      (
        now-lastFrame
      )/1000
    );


  lastFrame =
    now;


  const ordered =
    [...state.objects.values()]
      .sort(
        (a,b)=>
          (a.kind==='food') -
          (b.kind==='food')
      );


  for(
    const o
    of ordered
  ){

    updateObjectMotion(
      o,
      dt,
      night
    );


    const rec =
      state.images.get(
        o.id
      );


    if(!rec?.img){
      continue;
    }


    const img =
      rec.img;


    const base =

      o.kind==='food'
      ? 56

      : o.kind==='fish'
      ? 76

      : o.kind==='bird'
      ? 86

      : o.kind==='reptile'
      ? 74

      : 82;


    const scale =
      growthScale(o);


    const pulse =
      o.growPulse &&
      now-o.growPulse<1200

      ? (
          1 +
          Math.sin(
            (
              now-o.growPulse
            )/1200*Math.PI
          )*.22
        )

      : 1;


    const ww =
      base*
      scale*
      pulse;


    const hh =
      ww*
      (
        img.naturalHeight /
        img.naturalWidth
      );


    const x =
      o.rx*W;


    const y =
      o.ry*H;


    ctx.save();


    if(o.vx<0){

      ctx.translate(
        x,
        y
      );


      ctx.scale(
        -1,
        1
      );


      ctx.drawImage(
        img,
        -ww/2,
        -hh/2,
        ww,
        hh
      );

    }
    else{

      ctx.drawImage(
        img,
        x-ww/2,
        y-hh/2,
        ww,
        hh
      );
    }


    ctx.restore();


    o._box = {

      x:
        x-ww/2,

      y:
        y-hh/2,

      w:
        ww,

      h:
        hh
    };


    if(
      night &&
      o.kind!=='food'
    ){

      ctx.font =
        'bold 17px sans-serif';


      ctx.fillText(
        '💤',
        x+ww*.22,
        y-hh*.22+
        Math.sin(
          now/450+
          o.phase
        )*5
      );
    }


    const s =
      settings();


    if(
      s.show_names &&
      o.kind!=='food'
    ){

      ctx.font =
        '800 12px sans-serif';


      ctx.textAlign =
        'center';


      ctx.textBaseline =
        'middle';


      const label =
        o.name;


      const tw =
        ctx.measureText(
          label
        ).width + 14;


      ctx.fillStyle =
        'rgba(255,255,255,.86)';


      roundRect(
        ctx,
        x-tw/2,
        y+hh/2+4,
        tw,
        20,
        10
      );


      ctx.fill();


      ctx.fillStyle =
        '#29412c';


      ctx.fillText(
        label,
        x,
        y+hh/2+14
      );
    }
  }
}


function roundRect(
  c,
  x,
  y,
  w,
  h,
  r
){

  c.beginPath();

  c.moveTo(
    x+r,
    y
  );

  c.arcTo(
    x+w,
    y,
    x+w,
    y+h,
    r
  );

  c.arcTo(
    x+w,
    y+h,
    x,
    y+h,
    r
  );

  c.arcTo(
    x,
    y+h,
    x,
    y,
    r
  );

  c.arcTo(
    x,
    y,
    x+w,
    y,
    r
  );

  c.closePath();
}


